@using BerberVio.Models
@{
    ViewData["Title"] = "Dashboard";
    var todayAppointments = (List<AppointmentViewModel>)ViewBag.TodayAppointments;
}

<!-- Info boxes -->
<div class="row">
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box">
            <span class="info-box-icon text-bg-primary shadow-sm">
                <i class="bi bi-person-workspace"></i>
            </span>

            <div class="info-box-content">
                <span class="info-box-text">Toplam Çalışan</span>
                <span class="info-box-number">@ViewBag.TotalEmployees</span>
            </div>
            <!-- /.info-box-content -->
        </div>
        <!-- /.info-box -->
    </div>
    <!-- /.col -->
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box">
            <span class="info-box-icon text-bg-success shadow-sm">
                <i class="bi bi-scissors"></i>
            </span>

            <div class="info-box-content">
                <span class="info-box-text">Toplam Hizmet</span>
                <span class="info-box-number">@ViewBag.TotalServices</span>
            </div>
            <!-- /.info-box-content -->
        </div>
        <!-- /.info-box -->
    </div>
    <!-- /.col -->

    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box">
            <span class="info-box-icon text-bg-warning shadow-sm">
                <i class="bi bi-calendar-check"></i>
            </span>

            <div class="info-box-content">
                <span class="info-box-text">Toplam Randevu</span>
                <span class="info-box-number">@ViewBag.TotalAppointments</span>
            </div>
            <!-- /.info-box-content -->
        </div>
        <!-- /.info-box -->
    </div>
    <!-- /.col -->
    <div class="col-12 col-sm-6 col-md-3">
        <div class="info-box">
            <span class="info-box-icon text-bg-danger shadow-sm">
                <i class="bi bi-calendar2-week"></i>
            </span>

            <div class="info-box-content">
                <span class="info-box-text">Bugünkü Randevu</span>
                <span class="info-box-number">@todayAppointments.Count</span>
            </div>
            <!-- /.info-box-content -->
        </div>
        <!-- /.info-box -->
    </div>
    <!-- /.col -->
</div>
<!-- /.row -->

<!--begin::Row-->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Bugünkü Randevular</h3>
            </div>
            <!-- /.card-header -->
            <div class="card-body p-0">
                @if (todayAppointments.Count == 0)
                {
                    <p class="text-secondary text-center py-4 mb-0">Bugün randevu bulunmuyor.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table m-0">
                            <thead>
                                <tr>
                                    <th>Saat</th>
                                    <th>Çalışan</th>
                                    <th>Hizmet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in todayAppointments)
                                {
                                    <tr>
                                        <td>@appointment.AppointmentTime</td>
                                        <td>@appointment.EmployeeName</td>
                                        <td>@appointment.ServiceName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.table-responsive -->
                }
            </div>
            <!-- /.card-body -->
        </div>
        <!-- /.card -->
    </div>
    <!-- /.col -->
</div>
<!--end::Row-->

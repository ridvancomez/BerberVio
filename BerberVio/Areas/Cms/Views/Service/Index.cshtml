@model IEnumerable<BerberVio.Entities.Service>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Hizmetler</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Yeni Ekle
        </a>
    </div>
    <div class="card-body">
        <div id="service-table"></div>
    </div>
</div>

<!--begin::Delete Confirm Modal-->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Silme Onayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p><strong id="deleteServiceName"></strong> adlı hizmeti silmek istediğinize emin misiniz?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger">Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!--end::Delete Confirm Modal-->

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.4.0/dist/css/tabulator_bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tabulator-tables@6.4.0/dist/js/tabulator.min.js"></script>
    <script>
      const serviceData = @Html.Raw(Json.Serialize(Model));

      function escapeHtml(str) {
        return String(str ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function priceFormatter(cell) {
        const value = cell.getValue();
        return Number(value).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
      }

      function actionsFormatter(cell) {
        const row = cell.getRow().getData();
        return `
          <a href="/Cms/Service/Edit/${row.id}" class="btn btn-sm btn-primary me-1">
            <i class="bi bi-pencil-square"></i> Düzenle
          </a>
          <button type="button" class="btn btn-sm btn-danger btn-delete" data-id="${row.id}" data-name="${escapeHtml(row.name)}">
            <i class="bi bi-trash"></i> Sil
          </button>
        `;
      }

      new Tabulator('#service-table', {
        data: serviceData,
        layout: 'fitColumns',
        placeholder: 'Kayıt bulunamadı',
        columns: [
          { title: 'Id', field: 'id', width: 80 },
          { title: 'Ad', field: 'name' },
          { title: 'Fiyat', field: 'price', formatter: priceFormatter },
          { title: 'İşlemler', field: 'id', formatter: actionsFormatter, headerSort: false, hozAlign: 'right' },
        ],
      });

      document.getElementById('service-table').addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-delete');
        if (!btn) return;

        document.getElementById('deleteForm').action = '/Cms/Service/Delete/' + btn.dataset.id;
        document.getElementById('deleteServiceName').textContent = btn.dataset.name;

        new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
      });
    </script>
}

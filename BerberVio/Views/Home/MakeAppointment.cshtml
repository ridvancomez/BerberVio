@model BerberVio.Models.AppointmentViewModel
@{
    ViewData["Title"] = "Randevu Al";
    var busySlots = (List<string>)ViewBag.BusySlots;
}

<div class="container px-4 px-lg-5">
    <div class="row justify-content-center my-5">
        <div class="col-lg-6">
            <h1 class="font-weight-light text-center mb-4">Randevu Al</h1>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="card">
                <div class="card-body">
                    <form asp-controller="Home" asp-action="MakeAppointment" method="get">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="EmployeeId" class="form-label"></label>
                            <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees" onchange="this.form.submit()">
                                <option value="">Çalışan seçiniz</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ServiceId" class="form-label"></label>
                            <select asp-for="ServiceId" class="form-select" asp-items="ViewBag.Services">
                                <option value="">Hizmet seçiniz</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AppointmentDate" class="form-label"></label>
                            <input asp-for="AppointmentDate" type="date" class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="AppointmentTime" class="form-label"></label>
                            <select asp-for="AppointmentTime" class="form-select">
                                <option value="">Saat seçiniz</option>
                                @foreach (var slot in (string[])ViewBag.TimeSlots)
                                {
                                    if (busySlots.Contains(slot))
                                    {
                                        <option value="@slot" disabled>@slot (Dolu)</option>
                                    }
                                    else
                                    {
                                        <option value="@slot">@slot</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" formmethod="post" class="btn btn-primary">Randevu Al</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

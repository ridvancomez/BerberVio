@model IEnumerable<BerberVio.Entities.Service>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Page Content-->
<div class="container px-4 px-lg-5">
    <!-- Heading Row-->
    <div class="row gx-4 gx-lg-5 align-items-center my-5">
        <div class="col-lg-7"><img class="img-fluid rounded mb-4 mb-lg-0" src="https://dummyimage.com/900x400/dee2e6/6c757d.jpg" alt="BerberVio" /></div>
        <div class="col-lg-5">
            <h1 class="font-weight-light">BerberVio'ya Hoş Geldiniz</h1>
            <p>Deneyimli ekibimizle saç kesiminden sakal tıraşına, cilt bakımından saç boyamaya kadar tüm berberlik hizmetlerini sunuyoruz. Hemen randevunuzu oluşturun.</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="MakeAppointment">Randevu Al</a>
        </div>
    </div>
    <!-- Hakkımızda -->
    <div class="card text-white bg-secondary my-5 py-4 text-center">
        <div class="card-body">
            <h2 class="h4 text-white">Hakkımızda</h2>
            <p class="text-white m-0">Yılların verdiği tecrübeyle, güler yüzlü ve profesyonel ekibimizle sizlere en iyi hizmeti sunmak için buradayız.</p>
        </div>
    </div>
    <!-- Hizmetlerimiz -->
    <h2 class="text-center mb-4">Hizmetlerimiz</h2>
    <div class="row gx-4 gx-lg-5">
        @if (!Model.Any())
        {
            <p class="text-center text-secondary">Şu anda görüntülenecek hizmet bulunmuyor.</p>
        }
        else
        {
            @foreach (var service in Model)
            {
                <div class="col-md-4 mb-5">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="card-title h5">@service.Name</h2>
                            <p class="card-text">@service.Price.ToString("0.00") ₺</p>
                        </div>
                        <div class="card-footer"><a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="MakeAppointment">Randevu Al</a></div>
                    </div>
                </div>
            }
        }
    </div>
    <!-- İletişim -->
    <div class="card my-5">
        <div class="card-body text-center">
            <h2 class="card-title h4">İletişim</h2>
            <p class="card-text mb-1">Adres: Örnek Mahallesi, Örnek Caddesi No:1, İstanbul</p>
            <p class="card-text mb-1">Telefon: 0212 000 00 00</p>
            <p class="card-text mb-0">E-posta: info@berbervio.com</p>
        </div>
    </div>
</div>
